// SOD be gone
COPY_EXISTING ~BDSODTRN.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
        REPLACE_TEXTUALLY ~StartMovie("SODCIN01")~ ~~
        REPLACE_TEXTUALLY ~MoveToCampaign("SoD")~ ~CreateCreatureObject("K#TELBGT",Player1,0,0,0)~
    END


ACTION_BASH_FOR ~rick_bigg_mod/extend_bottom~ ~^.*\.baf$~ BEGIN
    EXTEND_BOTTOM ~%BASH_FOR_RES%.bcs~ ~%BASH_FOR_FILESPEC%~
END

ACTION_BASH_FOR ~rick_bigg_mod/extend_top~ ~^.*\.baf$~ BEGIN
    EXTEND_TOP ~%BASH_FOR_RES%.bcs~ ~%BASH_FOR_FILESPEC%~
END

