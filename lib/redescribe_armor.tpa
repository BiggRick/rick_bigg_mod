/*
Armor piece description redescriber.
Handles actual armor (AC is a number, armor_class shows damage type variants in parentheses).
*/

DEFINE_PATCH_FUNCTION redescribe_armor
    INT_VAR
        min_strength = 0
        armor_class = 0
        arcane_spells = 0
		speed_factor = 0
    STR_VAR
        physical_resistance = 0
        slashing_ac = 0
        piercing_ac = 0
        missile_ac = 0
        crushing_ac = 0
        locks = 0
        traps = 0
        pick_pockets = 0
        move_silently = 0
        hide = 0
BEGIN
	shield = 0
	LAUNCH_PATCH_MACRO common_preprocess
	LAUNCH_PATCH_MACRO minimum_strength
	LAUNCH_PATCH_MACRO build_armor_class
	LAUNCH_PATCH_MACRO armor_shield_shared_logic
	LAUNCH_PATCH_MACRO common_postprocess
END
