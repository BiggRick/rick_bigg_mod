/*
Armor piece description redescriber.
Handles actual armor (AC is a number, armor_class shows damage type variants in parentheses).
*/

DEFINE_PATCH_FUNCTION redescribe_armor
    INT_VAR
        min_strength = 0
        armor_class = 0
        arcane_spells = 0
		speed_factor = 0
        shield = 0
    STR_VAR
        physical_resistance = 0
        slashing_ac = 0
        piercing_ac = 0
        missile_ac = 0
        crushing_ac = 0
        locks = 0
        traps = 0
        pick_pockets = 0
        move_silently = 0
        hide = 0

        min_strength_special = ~~
        physical_resistance_special = ~~
        ac_special = ~~
        arcane_spells_special = ~~
        traps_special = ~~
        thieving_special = ~~
        stealth_special = ~~
        speed_factor_special = ~~
BEGIN
	LAUNCH_PATCH_MACRO common_preprocess
	LAUNCH_PATCH_MACRO minimum_strength


	// Remove "Armor Class:" lines that appear before "Requires:" (old style)
	// Only keep Armor Class under Equipped abilities
	PATCH_IF INDEX_BUFFER( ~^Armor Class: [^+%WNL%][^%WNL%]*$~ ) > 0 BEGIN
		REPLACE_TEXTUALLY ~^Armor Class: .*$~ ~~
	END

	TEXT_SPRINT ac_mods_string ~~
	SET $modifiers(~%slashing_ac%~) = 1
	SET $modifiers(~%piercing_ac%~) = 1
	SET $modifiers(~%missile_ac%~) = 1
	SET $modifiers(~%crushing_ac%~) = 1

	types_modifier = 0
	PATCH_PHP_EACH modifiers AS modifier => ignored BEGIN
		PATCH_IF NOT ~%modifier%~ STRING_EQUAL_CASE ~0~ BEGIN
			PATCH_IF types_modifier > 0 BEGIN
				TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%, ~
			END
			types_modifier += 1
			TEXT_SPRINT separator ~~
			PATCH_IF ~%modifier%~ STRING_EQUAL_CASE ~=0~ BEGIN
				TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%no protection vs. ~
			END ELSE PATCH_IF shield BEGIN
				PATCH_IF modifier > 0 BEGIN
					TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%an extra +%modifier% vs. ~
				END ELSE BEGIN
					TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%a %modifier% penalty vs. ~
				END
			END ELSE BEGIN
				value = armor_class - modifier
				TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%%value% vs. ~
			END

			PATCH_IF ~%modifier%~ STRING_EQUAL_CASE ~%slashing_ac%~ BEGIN
				TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%%separator%Slashing~
				TEXT_SPRINT separator ~, ~
			END
			PATCH_IF ~%modifier%~ STRING_EQUAL_CASE ~%crushing_ac%~ BEGIN
				TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%%separator%Crushing~
				TEXT_SPRINT separator ~, ~
			END
			PATCH_IF ~%modifier%~ STRING_EQUAL_CASE ~%piercing_ac%~ BEGIN
				TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%%separator%Piercing~
				TEXT_SPRINT separator ~, ~
			END
			PATCH_IF ~%modifier%~ STRING_EQUAL_CASE ~%missile_ac%~ BEGIN
				TEXT_SPRINT ~ac_mods_string~ ~%ac_mods_string%%separator%Missile~
				TEXT_SPRINT separator ~, ~
			END
		END
	END

	// Build Armor Class description (formatted as "+X" for shields, like armor version)
	// Format: "Armor Class: +X, modifiers"
	PATCH_IF shield BEGIN
		TEXT_SPRINT ac_string ~Armor Class: +%armor_class%~
	END ELSE BEGIN
		TEXT_SPRINT ac_string ~Armor Class: %armor_class%~
	END
	
	
	
	// Build final AC string with modifiers
	PATCH_IF NOT (~%ac_mods_string%~ STRING_EQUAL_CASE ~~) BEGIN
		TEXT_SPRINT ac_string ~%ac_string% (%ac_mods_string%)~
	END
    TEXT_SPRINT ac_string ~%ac_string%%ac_special%~

	// Update or inject Armor Class line (BEFORE Requires, like armor does)
	PATCH_IF NOT (~%ac_string%~ STRING_EQUAL_CASE ~~) BEGIN
		PATCH_IF INDEX_BUFFER( ~^Armor Class:.*$~ ) > 0 BEGIN
			REPLACE_TEXTUALLY ~^Armor Class:.*$~ ~%ac_string%~
		END ELSE BEGIN
			PATCH_IF INDEX_BUFFER( ~^Requires:~ ) > 0 BEGIN
				REPLACE_TEXTUALLY ~^Requires:~ ~%ac_string%%WNL%Requires:~
			END ELSE PATCH_IF INDEX_BUFFER( ~^Weight:~ ) > 0 BEGIN
				REPLACE_TEXTUALLY ~^Weight:~ ~%ac_string%%WNL%Weight:~
			END
		END
	END



	// Remove old AC lines from Equipped abilities section
	REPLACE_TEXTUALLY ~^- Armor Class:.*$~ ~~
	REPLACE_TEXTUALLY ~^- No protection against .*$~ ~~
	REPLACE_TEXTUALLY ~- No protection against .*$~ ~~
	
	// Build equipped abilities string (WITHOUT AC - AC is before Requires now)
	TEXT_SPRINT abilities_string ~~

	// Spellcasting - always show disabled/not disabled
	PATCH_IF (~%arcane_spells%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Arcane Spellcasting: disabled%arcane_spells_special%%WNL%~
	END ELSE BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Arcane Spellcasting: enabled%arcane_spells_special%%WNL%~
	END
	// Always remove old Spellcasting lines
	REPLACE_TEXTUALLY ~%WNL%\(Spellcasting\|Arcane Spellcasting\) is [^%WNL%]+%WNL%~ ~%WNL%~
	REPLACE_TEXTUALLY ~%WNL%- \(Spellcasting\|Arcane Spellcasting\) is [^%WNL%]+%WNL%~ ~%WNL%~

	// Physical Resistance
	PATCH_IF NOT (~%physical_resistance%~ STRING_EQUAL_CASE ~N~) BEGIN
        PATCH_IF NOT (~%physical_resistance%~ STRING_EQUAL_CASE ~0~) BEGIN
		    TEXT_SPRINT abilities_string ~%abilities_string%Physical Resistance: +%physical_resistance%%%physical_resistance_special%%WNL%~
        END
        // Always remove old Physical Resistance line
        REPLACE_TEXTUALLY ~^\(- \)?Physical Resistance:.*$~ ~~
	END

	// Speed Factor
	PATCH_IF NOT (~%speed_factor%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Speed Factor: %speed_factor%%speed_factor_special%%WNL%~
	END
	// Always remove old Speed Factor line
	REPLACE_TEXTUALLY ~^\(- \)?Speed Factor:.*$~ ~~

	// Lockpicking and Pick Pockets
	TEXT_SPRINT locks_check ~%locks%~
	TEXT_SPRINT pockets_check ~%pick_pockets%~
	TEXT_SPRINT locks_display ~%locks%~
	TEXT_SPRINT pockets_display ~%pick_pockets%~
	PATCH_IF NOT ("%locks%" STRING_COMPARE_REGEXP "^[+-]" = 0) BEGIN
		TEXT_SPRINT locks_display ~+%locks%%~
	END ELSE BEGIN
		TEXT_SPRINT locks_display ~%locks%%~
	END
	PATCH_IF NOT ("%pick_pockets%" STRING_COMPARE_REGEXP "^[+-]" = 0) BEGIN
		TEXT_SPRINT pockets_display ~+%pick_pockets%%~
	END ELSE BEGIN
		TEXT_SPRINT pockets_display ~%pick_pockets%%~
	END
	PATCH_IF (~%locks_check%~ STRING_EQUAL_CASE ~N~) OR (~%pockets_check%~ STRING_EQUAL_CASE ~N~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Thieving: disabled%thieving_special%%WNL%~
	END ELSE PATCH_IF (~%locks_check%~ STRING_EQUAL_CASE ~0~) AND (~%pockets_check%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Thieving: enabled (no modifiers)%thieving_special%%WNL%~
	END ELSE PATCH_IF (~%locks_check%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Thieving: enabled (%pockets_display% to Pick Pockets)%thieving_special%%WNL%~
	END ELSE PATCH_IF (~%pockets_check%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Thieving: enabled (%locks_display% to Open Locks)%thieving_special%%WNL%~
	END ELSE BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Thieving: enabled (%locks_display% to Open Locks, %pockets_display% to Pick Pockets)%thieving_special%%WNL%~
	END
	// Always remove old locks lines
	REPLACE_TEXTUALLY ~^\(- \)?Thieving .*$~ ~~
	REPLACE_TEXTUALLY ~^\(- \)?Open Locks:.*$~ ~~
	REPLACE_TEXTUALLY ~^\(- \)?Pick Pockets:.*$~ ~~

	// Find Traps
	PATCH_IF NOT (~%traps%~ STRING_EQUAL_CASE ~0~) AND NOT (~%traps%~ STRING_EQUAL_CASE ~N~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Find Traps: %traps%%%traps_special%%WNL%~
	END
	// Always remove old Find Traps line
	REPLACE_TEXTUALLY ~^\(- \)?Find Traps:.*$~ ~~

	// Move Silently and Hide in Shadows (grouped as "Stealth")
	TEXT_SPRINT move_silently_check ~%move_silently%~
	TEXT_SPRINT hide_check ~%hide%~
	TEXT_SPRINT move_silently_display ~%move_silently%~
	TEXT_SPRINT hide_display ~%hide%~
	PATCH_IF NOT ("%move_silently%" STRING_COMPARE_REGEXP "^[+-]" = 0) BEGIN
		TEXT_SPRINT move_silently_display ~+%move_silently%%~
	END ELSE BEGIN
		TEXT_SPRINT move_silently_display ~%move_silently%%~
	END
	PATCH_IF NOT ("%hide%" STRING_COMPARE_REGEXP "^[+-]" = 0) BEGIN
		TEXT_SPRINT hide_display ~+%hide%%~
	END ELSE BEGIN
		TEXT_SPRINT hide_display ~%hide%%~
	END
	PATCH_IF (~%move_silently_check%~ STRING_EQUAL_CASE ~N~) OR (~%hide_check%~ STRING_EQUAL_CASE ~N~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Stealth: disabled%stealth_special%%WNL%~
	END ELSE PATCH_IF (~%move_silently_check%~ STRING_EQUAL_CASE ~0~) AND (~%hide_check%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Stealth: enabled (no modifiers)%stealth_special%%WNL%~
	END ELSE PATCH_IF (~%move_silently_check%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Stealth: enabled (%hide_display% to Hide In Shadows)%stealth_special%%WNL%~
	END ELSE PATCH_IF (~%hide_check%~ STRING_EQUAL_CASE ~0~) BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Stealth: enabled (%move_silently_display% to Move Silently)%stealth_special%%WNL%~
	END ELSE BEGIN
		TEXT_SPRINT abilities_string ~%abilities_string%Stealth: enabled (%move_silently_display% to Move Silently, %hide_display% to Hide In Shadows)%stealth_special%%WNL%~
	END
	// Always remove old Stealth/Move Silently/Hide lines
	REPLACE_TEXTUALLY ~^\(- \)?Stealth .*$~ ~~
	REPLACE_TEXTUALLY ~^\(- \)?Move Silently:.*$~ ~~
	REPLACE_TEXTUALLY ~^\(- \)?Hide in Shadows:.*$~ ~~

	// Clean up empty lines within equipped abilities list (remove blank lines before "-" items)
	REPLACE_TEXTUALLY ~\(%WNL%\)+- ~ ~%WNL%- ~

	// Update equipped abilities section
	PATCH_IF NOT (~%abilities_string%~ STRING_EQUAL_CASE ~~) BEGIN
        REPLACE_TEXTUALLY ~%WNL%Requires:%WNL%~ ~%WNL%%WNL%%abilities_string%%WNL%Requires:%WNL%~
	END

	LAUNCH_PATCH_MACRO common_postprocess

	FOR (i = 0; i < 10; i += 1) BEGIN
		// Remove empty headers and normalize the separator before Armor Class.
		REPLACE_TEXTUALLY ~Equipped abilities:[%WNL%]+Armor Class:~ ~Armor Class:~

		REPLACE_TEXTUALLY ~Armor Class:\([^%WNL%]+\)[%WNL%]+Arcane Spellcasting:~ ~Armor Class:\1%WNL%Arcane Spellcasting:~
		REPLACE_TEXTUALLY ~[%WNL%]+Requires:~ ~%WNL%Requires:~
		REPLACE_TEXTUALLY ~[%WNL%]+Armor Class:~ ~%WNL%%WNL%Armor Class:~
	END
END
