INCLUDE "rick_bigg_mod/lib/add_cre_proficiency.tpa"

COPY_EXISTING ~karlat.cre~ ~override~
	LAUNCH_PATCH_FUNCTION add_cre_proficiency
		INT_VAR pips = 3
		STR_VAR proficiency = "PROFICIENCYAXE"
	END
	LAUNCH_PATCH_FUNCTION add_cre_proficiency
		INT_VAR pips = 1
		STR_VAR proficiency = "PROFICIENCYSWORDANDSHIELD"
	END
	WRITE_BYTE 0x238 18
	WRITE_BYTE 0x239 58
	WRITE_BYTE 0x23c 15
	WRITE_BYTE 0x23d 17
	WRITE_LONG 0x14 420
	WRITE_SHORT 0x24 50
	WRITE_SHORT 0x26 50

