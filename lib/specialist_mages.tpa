COPY_EXISTING ~L_%EE_LANGUAGE%.lua~ ~override~
	APPEND_FILE TEXT ~rick_bigg_mod/copy/m_rbm_spec.lua~ EVALUATE_BUFFER
BUT_ONLY

ACTION_CLEAR_ARRAY rbm_spec_abjuration
ACTION_CLEAR_ARRAY rbm_spec_conjuration
ACTION_CLEAR_ARRAY rbm_spec_divination
ACTION_CLEAR_ARRAY rbm_spec_enchantment
ACTION_CLEAR_ARRAY rbm_spec_illusion
ACTION_CLEAR_ARRAY rbm_spec_invocation
ACTION_CLEAR_ARRAY rbm_spec_necromancy
ACTION_CLEAR_ARRAY rbm_spec_alteration
ACTION_CLEAR_ARRAY rbm_spec_kit_names
ACTION_CLEAR_ARRAY rbm_spec_hidden

COPY_EXISTING ~clastext.2da~ ~override~
	COUNT_2DA_COLS colcount
	READ_2DA_ENTRIES_NOW clastext_data colcount
	FOR (row = 0; row < clastext_data; ++row) BEGIN
		READ_2DA_ENTRY_FORMER clastext_data row 0 kit_name
		READ_2DA_ENTRY_FORMER clastext_data row 5 name_strref
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~ABJURER~ BEGIN
			SPRINT $rbm_spec_kit_names("22") ~%name_strref%~
		END
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~CONJURER~ BEGIN
			SPRINT $rbm_spec_kit_names("23") ~%name_strref%~
		END
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~DIVINER~ BEGIN
			SPRINT $rbm_spec_kit_names("24") ~%name_strref%~
		END
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~ENCHANTER~ BEGIN
			SPRINT $rbm_spec_kit_names("25") ~%name_strref%~
		END
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~ILLUSIONIST~ BEGIN
			SPRINT $rbm_spec_kit_names("26") ~%name_strref%~
		END
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~INVOKER~ BEGIN
			SPRINT $rbm_spec_kit_names("27") ~%name_strref%~
		END
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~NECROMANCER~ BEGIN
			SPRINT $rbm_spec_kit_names("28") ~%name_strref%~
		END
		PATCH_IF "%kit_name%" STRING_EQUAL_CASE ~TRANSMUTER~ BEGIN
			SPRINT $rbm_spec_kit_names("29") ~%name_strref%~
		END
	END
	BUT_ONLY

SILENT
ACTION_PHP_EACH rbm_spec_kit_names AS kit=>name_strref BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecKitNameStrref[%kit%] = %name_strref%~
END
VERBOSE

ACTION_IF FILE_EXISTS_IN_GAME ~hidespl.2da~ BEGIN
	COPY_EXISTING - ~hidespl.2da~ ~nowhere~
		REPLACE_EVALUATE ~\([A-Z0-9]+\)[ %TAB%]+1~ BEGIN
			SPRINT $rbm_spec_hidden("%MATCH1%") ~1~
		END
		~~
	BUT_ONLY
END

COPY_EXISTING_REGEXP ~^SPWI[1-9][0-9A-Z]+\.spl$~ ~override~
	READ_SHORT 0x1c spell_type
	READ_LONG 0x34 spell_level
	READ_BYTE 0x25 spell_school
	PATCH_IF spell_type = 1 && spell_level > 0 && spell_level < 10 && spell_school > 0 && (BYTE_AT 0x1f BAND 0b01000000) = 0 BEGIN
		SPRINT resref ~%SOURCE_RES%~
		TO_UPPER resref
		PATCH_IF !VARIABLE_IS_SET $rbm_spec_hidden("%resref%") BEGIN
			SPRINT spell_num ~%resref%~
			INNER_PATCH_SAVE spell_num ~%spell_num%~ BEGIN
				REPLACE_TEXTUALLY ~SPWI~ ~2~
			END
			PATCH_IF IS_AN_INT spell_num BEGIN
				LOOKUP_IDS_SYMBOL_OF_INT spell_name spell spell_num
			END ELSE BEGIN
				SPRINT spell_name ~NOT_IDENTIFIED~
			END
				PATCH_IF spell_school = 1 BEGIN SET $rbm_spec_abjuration("%resref%") = spell_level END
				PATCH_IF spell_school = 2 BEGIN SET $rbm_spec_conjuration("%resref%") = spell_level END
				PATCH_IF spell_school = 3 BEGIN SET $rbm_spec_divination("%resref%") = spell_level END
				PATCH_IF spell_school = 4 BEGIN SET $rbm_spec_enchantment("%resref%") = spell_level END
				PATCH_IF spell_school = 5 BEGIN SET $rbm_spec_illusion("%resref%") = spell_level END
				PATCH_IF spell_school = 6 BEGIN SET $rbm_spec_invocation("%resref%") = spell_level END
				PATCH_IF spell_school = 7 BEGIN SET $rbm_spec_necromancy("%resref%") = spell_level END
				PATCH_IF spell_school = 8 BEGIN SET $rbm_spec_alteration("%resref%") = spell_level END
		END
	END
BUT_ONLY

SILENT
ACTION_PHP_EACH rbm_spec_abjuration AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.abjuration["%spell%"] = %level%~
END
ACTION_PHP_EACH rbm_spec_conjuration AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.conjuration["%spell%"] = %level%~
END
ACTION_PHP_EACH rbm_spec_divination AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.divination["%spell%"] = %level%~
END
ACTION_PHP_EACH rbm_spec_enchantment AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.enchantment["%spell%"] = %level%~
END
ACTION_PHP_EACH rbm_spec_illusion AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.illusion["%spell%"] = %level%~
END
ACTION_PHP_EACH rbm_spec_invocation AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.invocation["%spell%"] = %level%~
END
ACTION_PHP_EACH rbm_spec_necromancy AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.necromancy["%spell%"] = %level%~
END
ACTION_PHP_EACH rbm_spec_alteration AS spell=>level BEGIN
	APPEND ~L_%EE_LANGUAGE%.lua~ ~rbmSpecSpellLists.alteration["%spell%"] = %level%~
END
	COPY_EXISTING ~ui.menu~ ~override~
		// Remove broad patches left by earlier builds. Each spell menu is scoped below.
		REPLACE_TEXTUALLY ~createCharScreen:IsDoneButtonClickable() and rbmSpecialistRequirementsSatisfied(mageSpells)~ ~createCharScreen:IsDoneButtonClickable()~

		PATCH_IF INDEX_BUFFER(~name 'CHARGEN_CHOOSE_SPELLS'~) >= 0 BEGIN
			PATCH_IF INDEX_BUFFER(~name 'CHARGEN_CHOOSE_SPELLS'
	onClose "rbmSpecialistSpellSelectionActive = false"~) < 0 BEGIN
				REPLACE_TEXTUALLY EXACT_MATCH ~name 'CHARGEN_CHOOSE_SPELLS'~ ~name 'CHARGEN_CHOOSE_SPELLS'
	onClose "rbmSpecialistSpellSelectionActive = false"~
			END
			PATCH_IF INDEX_BUFFER(~table.sort(chargen.choose_spell, sortBySpellName)%WNL%		rbmSpecialistSpellSelectionActive = true~) < 0 BEGIN
				REPLACE_TEXTUALLY EXACT_MATCH ~table.sort(chargen.choose_spell, sortBySpellName)~ ~table.sort(chargen.choose_spell, sortBySpellName)%WNL%		rbmSpecialistSpellSelectionActive = true~
			END
			SET sort_index=INDEX_BUFFER(~table.sort(chargen.choose_spell, sortBySpellName)~)
			PATCH_IF sort_index>=0 BEGIN
				SET done_index=INDEX_BUFFER(~clickable lua "createCharScreen:IsDoneButtonClickable()"~ sort_index)
				PATCH_IF done_index>=0 BEGIN
					SPRINT old_done ~clickable lua "createCharScreen:IsDoneButtonClickable()"~
					SPRINT new_done ~clickable lua "createCharScreen:IsDoneButtonClickable() and rbmSpecialistRequirementsSatisfied(spellBook)"~
					DELETE_BYTES done_index (STRING_LENGTH "%old_done%")
					INSERT_BYTES done_index (STRING_LENGTH "%new_done%")
					WRITE_ASCIIE done_index "%new_done%"
				END ELSE BEGIN
					PATCH_WARN ~Unable to locate the CHARGEN_CHOOSE_SPELLS Done button in ui.menu.~
				END
			END
		END ELSE BEGIN
			PATCH_WARN ~Unable to locate CHARGEN_CHOOSE_SPELLS in ui.menu; specialist spell learning will not be enforced.~
		END

		PATCH_IF INDEX_BUFFER(~name 'CHARGEN_MEMORIZE_MAGE'~) >= 0 BEGIN
			PATCH_IF INDEX_BUFFER(~name 'CHARGEN_MEMORIZE_MAGE'
	onClose "rbmSpecialistSpellSelectionActive = false"~) < 0 BEGIN
				REPLACE_TEXTUALLY EXACT_MATCH ~name 'CHARGEN_MEMORIZE_MAGE'~ ~name 'CHARGEN_MEMORIZE_MAGE'
	onClose "rbmSpecialistSpellSelectionActive = false"~
			END
			PATCH_IF INDEX_BUFFER(~table.sort(chargen.choose_spell, sortByMageSpellName)%WNL%		rbmSpecialistSpellSelectionActive = true~) < 0 BEGIN
				REPLACE_TEXTUALLY EXACT_MATCH ~table.sort(chargen.choose_spell, sortByMageSpellName)~ ~table.sort(chargen.choose_spell, sortByMageSpellName)%WNL%		rbmSpecialistSpellSelectionActive = true~
			END
			SET sort_index=INDEX_BUFFER(~table.sort(chargen.choose_spell, sortByMageSpellName)~)
			PATCH_IF sort_index>=0 BEGIN
				SET done_index=INDEX_BUFFER(~clickable lua "createCharScreen:IsDoneButtonClickable()"~ sort_index)
				PATCH_IF done_index>=0 BEGIN
					SPRINT old_done ~clickable lua "createCharScreen:IsDoneButtonClickable()"~
					SPRINT new_done ~clickable lua "createCharScreen:IsDoneButtonClickable() and rbmSpecialistRequirementsSatisfied(mageSpells)"~
					DELETE_BYTES done_index (STRING_LENGTH "%old_done%")
					INSERT_BYTES done_index (STRING_LENGTH "%new_done%")
					WRITE_ASCIIE done_index "%new_done%"
				END ELSE BEGIN
					PATCH_WARN ~Unable to locate the CHARGEN_MEMORIZE_MAGE Done button in ui.menu.~
				END
			END
		END ELSE BEGIN
			PATCH_WARN ~Unable to locate CHARGEN_MEMORIZE_MAGE in ui.menu; specialist spell memorization will not be enforced.~
		END

		PATCH_IF INDEX_BUFFER(~bookSpells~) >= 0 BEGIN
			REPLACE_TEXTUALLY ~^\(.*\)bam[ %TAB%]+lua[ %TAB%]+"bookSpells\[rowNumber\]\.icon"~ ~\1bam	lua "bookSpells[rowNumber].icon"%WNL%\1greyscale lua "bookMode==0 and not rbmSpecialistCanMemorize(bookSpells[rowNumber])"~
			REPLACE_TEXTUALLY ~\(mageScreen:MemorizeSpell([ %TAB%]*bookSpells\[currentBookSpell\]\.level,[ %TAB%]*bookSpells\[currentBookSpell\]\.index )\)~ ~if rbmSpecialistCanMemorize(bookSpells[currentBookSpell]) then \1 end~
			REPLACE_TEXTUALLY ~#bottomSpells < #bottomSpellsPlaceHolder~ ~#bottomSpells < #bottomSpellsPlaceHolder and rbmSpecialistCanMemorize(bookSpells[currentBookSpell])~
		END ELSE BEGIN
			PATCH_WARN ~Unable to locate the mage spellbook list in ui.menu; specialist memorization will not be enforced outside character creation.~
		END
	BUT_ONLY
