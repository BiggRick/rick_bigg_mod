COPY_EXISTING ~ui.menu~ ~override~
	PATCH_IF INDEX_BUFFER(~rbmSpecialistRequirementsSatisfied~) < 0 BEGIN
		PATCH_IF INDEX_BUFFER(~clickable lua "createCharScreen:IsDoneButtonClickable()"~) >= 0 BEGIN
			REPLACE_TEXTUALLY ~clickable lua "createCharScreen:IsDoneButtonClickable()"~ ~clickable lua "createCharScreen:IsDoneButtonClickable() and rbmSpecialistRequirementsSatisfied(mageSpells)"~
		END ELSE BEGIN
			PATCH_WARN ~Unable to locate the mage memorization Done button in ui.menu; specialist spell selection will not be enforced during character creation.~
		END
		PATCH_IF INDEX_BUFFER(~bookSpells~) >= 0 BEGIN
			REPLACE_TEXTUALLY ~^\(.*\)bam[ %TAB%]+lua[ %TAB%]+"bookSpells\[rowNumber\]\.icon"~ ~\1bam	lua "bookSpells[rowNumber].icon"%WNL%\1greyscale lua "bookMode==0 and not rbmSpecialistCanMemorize(bookSpells[rowNumber])"~
			REPLACE_TEXTUALLY ~\(mageScreen:MemorizeSpell([ %TAB%]*bookSpells\[currentBookSpell\]\.level,[ %TAB%]*bookSpells\[currentBookSpell\]\.index )\)~ ~if rbmSpecialistCanMemorize(bookSpells[currentBookSpell]) then \1 end~
			REPLACE_TEXTUALLY ~#bottomSpells < #bottomSpellsPlaceHolder~ ~#bottomSpells < #bottomSpellsPlaceHolder and rbmSpecialistCanMemorize(bookSpells[currentBookSpell])~
		END ELSE BEGIN
			PATCH_WARN ~Unable to locate the mage spellbook list in ui.menu; specialist memorization will not be enforced outside character creation.~
		END
	END
BUT_ONLY
