<<<<<<<< .../script-all-creatures.baf

IF
    Global("tb#scalpInit","LOCALS",0)
    General(Myself, HUMANOID)
    HasItem("MISC86", Myself)
THEN RESPONSE #100
    DestroyItem("MISC86")
    SetGlobal("tb#scalpInit","LOCALS",1)
    Continue()
END

IF
    Global("tb#scalpInit","LOCALS",0)
    General(Myself, HUMANOID)
    !HasItem("MISC86", Myself)
THEN RESPONSE #100
    SetGlobal("tb#scalpInit","LOCALS",51)
    Continue()
END

IF
    Global("tb#scalpInit","LOCALS",1)
    Global("metVai","GLOBAL",1)
    !Global("tb#vaiLeft","GLOBAL",1)
THEN RESPONSE #100
    CreateItem("MISC86", 1, 0, 0)
    SetGlobal("tb#scalpInit","LOCALS",2)
    Continue()
END

IF
    Global("tb#scalpInit","LOCALS",2)
    Global("tb#vaiLeft","GLOBAL",1)
THEN RESPONSE #100
    DestroyItem("MISC86")
    SetGlobal("tb#scalpInit","LOCALS",3)
    Continue()
END

IF
    Global("tb#scalpInit","LOCALS",51)
    Global("metVai","GLOBAL",1)
    !Global("tb#vaiLeft","GLOBAL",1)
THEN RESPONSE #100
    CreateItem("tb#scalp", 1, 0, 0)
    SetGlobal("tb#scalpInit","LOCALS",52)
    Continue()
END

IF
    Global("tb#scalpInit","LOCALS",52)
    Global("tb#vaiLeft","GLOBAL",1)
THEN RESPONSE #100
    DestroyItem("tb#scalp")
    SetGlobal("tb#scalpInit","LOCALS",53)
    Continue()
END
