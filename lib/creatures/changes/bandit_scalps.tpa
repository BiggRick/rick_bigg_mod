COPY - ~.../script-all-creatures.baf~ ~.../script-all-creatures.baf~
    PATCH_PHP_EACH JOINABLE_NPC_ARRAY_dv AS dv => X BEGIN
        REPLACE_TEXTUALLY ~NOT_A_PG~ ~NOT_A_PG !Name("%dv%",Myself)~
    END
    REPLACE_TEXTUALLY ~NOT_A_PG~ ~~


COPY_EXISTING ~misc86.itm~ ~override~
    WRITE_LONG 0x34 10

COPY_EXISTING ~misc86.itm~ ~override/tb#scalp.itm~
    SAY NAME1 ~Humanoid scalp~
    SAY NAME2 ~Humanoid scalp~
    SAY UNIDENTIFIED_DESC ~This is the scalp of a humanoid. Unscrupulous people might try to pass it off as a bandit scalp.

STATISTICS:

Weight: 0~
    WRITE_ASCII 0x3a ~TB#SCALP~ #8


