COPY_EXISTING ~misc86.itm~ ~override/tb#scalp.itm~
    SAY NAME1 ~Humanoid scalp~
    SAY NAME2 ~Humanoid scalp~
    SAY UNIDENTIFIED_DESC ~This is the scalp of a humanoid. Unscrupulous people might try to pass it off as a bandit scalp.

STATISTICS:

Weight: 0~

SILENT
COPY_EXISTING_REGEXP GLOB ~^.*\.cre$~ ~override~
  found = 0
  FOR (iter = 0; iter < 2; ++iter) BEGIN
    offset = SCRIPT_DEFAULT
    WHILE (offset >= SCRIPT_OVERRIDE && !found) BEGIN
      READ_ASCII offset script
      TO_UPPER script
      PATCH_IF $done (EVALUATE_BUFFER ~%script%~) STRING_EQUAL_CASE ~%name%~ THEN BEGIN
        found = 1
      END ELSE PATCH_IF !FILE_EXISTS_IN_GAME ~%script%.bcs~ || ~%script%~ STRING_EQUAL_CASE ~none~ || ~%script%~ STRING_EQUAL_CASE ~~ || ~%script%~ STRING_EQUAL_CASE ~ ~ THEN BEGIN
         offset -= 8
      END ELSE PATCH_IF iter = 1 BEGIN
        SPRINT $done (EVALUATE_BUFFER ~%script%~) ~%name%~
        INNER_ACTION BEGIN
          EXTEND_BOTTOM ~%script%.bcs~ ~.../script-all-creatures.baf~
        END
        found = 1
      END ELSE BEGIN
        offset -= 8
      END
    END
  END
BUT_ONLY
VERBOSE
