IF
    Global("tb#scalpInit","LOCALS",0)
    OR (4)
        HasItem("MISC86", Myself)
        Race(Myself, HOBGOBLIN)
        Race(Myself, GNOLL)
        Race(Myself, OGRE)
THEN RESPONSE #100
    SetGlobal("tb#scalpInit","LOCALS",1)
    DestroyItem("MISC86")
END

IF
    Global("tb#scalpInit","LOCALS",0)
    OR (7)
        Race(Myself, HUMAN)
        Race(Myself, ELF)
        Race(Myself, HALF_ELF)
        Race(Myself, DWARF)
        Race(Myself, HALFLING)
        Race(Myself, GNOME)
        Race(Myself, HALFORC)
    !HasItem("MISC86", Myself)
THEN RESPONSE #100
    SetGlobal("tb#scalpInit","LOCALS",51)
END

IF
    Global("tb#scalpInit","LOCALS",1)
    Global("metVai","GLOBAL",1)
    !Global("tb#vaiLeft","GLOBAL",1)
    GlobalLT("chapter","GLOBAL",5)
    Allegiance(Myself, ENEMY)
    !Gender(Myself, SUMMONED)
    !Gender(Myself, ILLUSIONARY)
    !Gender(Myself, SUMMONED_DEMON)
    !Gender(Myself, NIETHER)
THEN RESPONSE #100
    CreateItem("MISC86", 1, 0, 0)
    SetGlobal("tb#scalpInit","LOCALS",2)
END

IF
    Global("tb#scalpInit","LOCALS",2)
    OR(2)
        Global("tb#vaiLeft","GLOBAL",1)
        GlobalGT("chapter","GLOBAL",4)
THEN RESPONSE #100
    SetGlobal("tb#scalpInit","LOCALS",3)
    DestroyItem("MISC86")
END

IF
    Global("tb#scalpInit","LOCALS",51)
    Global("metVai","GLOBAL",1)
    !Global("tb#vaiLeft","GLOBAL",1)
    !Global("tb#collectInnocentScalps","GLOBAL", 1)
    GlobalLT("chapter","GLOBAL",5)
    !InPartySlot(Myself, 0)
    !InPartySlot(Myself, 1)
    !InPartySlot(Myself, 2)
    !InPartySlot(Myself, 3)
    !InPartySlot(Myself, 4)
    !InPartySlot(Myself, 5)
    Allegiance(Myself, ENEMY)
    !Gender(Myself, SUMMONED)
    !Gender(Myself, ILLUSIONARY)
    !Gender(Myself, SUMMONED_DEMON)
    !Gender(Myself, NIETHER)
    NOT_A_PG
THEN RESPONSE #100
    CreateItem("tb#scalp", 1, 0, 0)
    SetGlobal("tb#scalpInit","LOCALS",52)
END

IF
    Global("tb#scalpInit","LOCALS",52)
    OR (3)
        Global("tb#vaiLeft","GLOBAL",1)
        Global("tb#collectInnocentScalps","GLOBAL", 1)
        GlobalGT("chapter","GLOBAL",4)
THEN RESPONSE #100
    SetGlobal("tb#scalpInit","LOCALS",53)
    DestroyItem("tb#scalp")
END
